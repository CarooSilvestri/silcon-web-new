---
import { SITE, SOCIAL_LINKS } from "../data/site";
import { internalPath } from "../utils/paths";

const currentYear = new Date().getFullYear();
---

<footer id="contacto">
  <div class="footer-title">
    <p>Hoy, mañana, siempre</p>
    <h2>Estamos para acompañarte.</h2>
  </div>
  <div class="footer-contact">
    <span>Asistencia técnica y consultas · 24/7/365</span>
    <a href={SITE.whatsappHref}>{SITE.whatsapp} ↗</a>
    <button type="button" class="footer-copy" data-footer-copy={SITE.email} aria-label={`Copiar ${SITE.email}`}>
      <span>{SITE.email}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <rect x="8" y="8" width="11" height="11" rx="1.5"></rect>
        <path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-10A1.5 1.5 0 0 0 3 5.5v10A1.5 1.5 0 0 0 4.5 17H8"></path>
      </svg>
    </button>
    <p>{SITE.locationShort}</p>
  </div>
  <div class="footer-social-column">
    <span>Seguinos</span>
    <div class="footer-social">
      {SOCIAL_LINKS.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer">
          <img src={social.icon} alt="" width="20" height="20" loading="lazy" decoding="async" />
          <span>{social.name}</span>
        </a>
      ))}
    </div>
  </div>
  <div class="footer-bottom">
    <img class="footer-logo" src={internalPath("assets/logo-silcon.webp")} alt="Silcon Electrónica" width="200" height="40" loading="lazy" decoding="async" />
    <div class="footer-credit">
      <p>© SILCON {currentYear}</p>
      <p>Diseño y desarrollo por <a href={SITE.designerHref} target="_blank" rel="noopener noreferrer">CarooDesigns ↗</a></p>
    </div>
    <div class="footer-legal">
      <a href={SITE.fiscalHref} target="_blank" rel="noopener noreferrer" aria-label="Información fiscal de Silcon">
        <img src={internalPath("assets/data-fiscal.webp")} alt="Data Fiscal ARCA" width="40" height="55" loading="lazy" decoding="async" />
      </a>
    </div>
  </div>
</footer>

<script>
  const fallbackFooterCopy = (text: string) => {
    const input = document.createElement("textarea");
    input.value = text;
    input.setAttribute("readonly", "");
    input.style.position = "fixed";
    input.style.opacity = "0";
    document.body.appendChild(input);
    input.select();
    const legacyCopy = Reflect.get(document, "execCommand");
    const copied = typeof legacyCopy === "function" && Reflect.apply(legacyCopy, document, ["copy"]);
    input.remove();
    if (!copied) throw new Error("Copy is unavailable");
  };

  let footerCopyTimer: number | undefined;

  const setupFooterCopy = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-footer-copy]").forEach((button) => {
      button.onclick = async () => {
        const text = button.dataset.footerCopy ?? "";
        let copied = true;

        try {
          await navigator.clipboard.writeText(text);
        } catch {
          try {
            fallbackFooterCopy(text);
          } catch {
            copied = false;
          }
        }

        button.classList.toggle("is-copied", copied);
        button.setAttribute("aria-label", copied ? `${text} copiado` : "No se pudo copiar el correo");
        window.clearTimeout(footerCopyTimer);
        footerCopyTimer = window.setTimeout(() => {
          button.classList.remove("is-copied");
          button.setAttribute("aria-label", `Copiar ${text}`);
        }, 1800);
      };
    });
  };

  setupFooterCopy();
  document.addEventListener("astro:page-load", setupFooterCopy);
</script>
